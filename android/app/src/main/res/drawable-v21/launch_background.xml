<?xml version="1.0" encoding="utf-8"?>
<!-- 木照启动底色（API 21+ 覆盖版）：复用自适应图标背景（木色垂直渐变）。
     原 `?android:colorBackground` 在浅色主题下是白色，深色外观的 App 冷启动会白闪（G5B.13）。
     API 31+ 走 SplashScreen API 时本文件同样不被使用。改动者：store-assets（res/drawable* 归属）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
</layer-list>
